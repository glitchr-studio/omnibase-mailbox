{# "A message awaits you": a link to sign in and read it - never its content, its subject, nor who wrote. #}
<!DOCTYPE html>
<html lang="{{ app.request ? app.request.locale : 'fr' }}">
<body style="margin:0;padding:24px;background:#f4f5f2;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.5;color:#1c2421;">
<div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;padding:28px;">
<p>{{ 'email.notify.hello'|trans({}, 'mailbox') }}</p>
<p>{{ 'email.notify.body'|trans({}, 'mailbox') }}</p>
<p><a href="{{ url }}" style="display:inline-block;padding:12px 20px;background:#1f5f4a;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:bold;">{{ 'email.notify.button'|trans({}, 'mailbox') }}</a></p>
<p style="font-size:14px;color:#5a6660;">{{ 'email.notify.why'|trans({}, 'mailbox') }}</p>
</div>
</body>
</html>
