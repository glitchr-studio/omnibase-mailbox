{
    "name": "omnibase/mailbox",
    "type": "symfony-bundle",
    "description": "Private messaging for base-bundle: member-to-member conversations with an inbox, archives, read state, quotas and flood control",
    "keywords": [
        "symfony",
        "mailbox",
        "messaging",
        "private messages"
    ],
    "homepage": "https://github.com/glitchr-studio/omnibase-mailbox",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Base\\Mailbox\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Base\\Mailbox\\": "./tests"
        }
    },
    "require": {
        "php": "^8.2",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0",
        "doctrine/orm": "^2.15|^3.0",
        "glitchr/omnibase": "3.0.*-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html var/coverage --coverage-text"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "minimum-stability": "dev",
        "allow-plugins": {
            "glitchr/base-plugin": true,
            "glitchr/doctrine-dc2type": true,
            "php-http/discovery": true
        }
    },
    "suggest": {
        "ext-sodium": "Subjects and messages stored encrypted (mailbox.encrypt)",
        "omnibase/office": "Attachments kept in the office's encrypted document vault (mailbox.attachments)",
        "symfony/mailer": "The notice that a message awaits (mailbox.notify)"
    }
}
